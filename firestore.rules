rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blogs/{blogId} {
      allow read: if true;
      // Only this Google account can add/edit/delete blogs
      allow write: if request.auth != null
        && request.auth.token.email == 'ulainnoor957@gmail.com';
    }
  }
}
