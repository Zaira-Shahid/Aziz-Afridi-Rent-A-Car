rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'ulainnoor957@gmail.com',
          'developerx.org@gmail.com',
          'signaturesrentacar@gmail.com',
          'xfirebasc@gmail.com'
        ];
    }
  }
}
