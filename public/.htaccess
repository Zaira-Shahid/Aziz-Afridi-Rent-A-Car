DirectoryIndex index.html
Options -Indexes

# Serve clean URLs / folders with index.html (Apache / cPanel)
RewriteEngine On
RewriteBase /

# If request is a file, serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# If request is a directory with index.html, let Apache serve it
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# Fallback for any leftover .html files
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
